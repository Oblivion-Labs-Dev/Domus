# Database (SQLite local file by default; supports Turso / libSQL URLs for cloud deployment)
DATABASE_URL=file:./data/domus.db

# Session signing secret (generate a random 32+ char string for production)
DOMUS_SESSION_SECRET=change-me-to-a-long-random-secret-in-production

# Enable one-click family member switcher in development/demo mode (set to "false" in production)
NEXT_PUBLIC_ENABLE_DEMO_SWITCHER=true
